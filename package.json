{
  "name": "fretzee-obsidian",
  "version": "0.4.1",
  "private": true,
  "description": "Render Fretzee diagrams, sheets, chord progressions, and vault Guitar Pro excerpts in Obsidian notes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "oxlint src scripts tests && eslint src --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test",
    "spec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "fretzee": "0.3.6"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.10.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastienferry/fretzee-obsidian.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienferry/fretzee-obsidian/issues"
  },
  "homepage": "https://github.com/sebastienferry/fretzee-obsidian#readme",
  "overrides": {
    "moment": "2.31.0"
  }
}
